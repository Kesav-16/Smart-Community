  "font_size": 14,
  "format_data": null,
  "html": "<div style=\"font-family: Arial, Helvetica, sans-serif; color:#222; padding:20px;\">\r\n\r\n  <!-- Optional logo (make sure file exists at apps/smart_community/smart_community/public/images/logo.png) -->\r\n  <!--<div style=\"text-align:center; margin-bottom:10px;\">-->\r\n  <!--  <img src=\"/assets/smart_community/images/logo.png\" alt=\"Logo\" style=\"height:50px; display:block; margin:0 auto;\">-->\r\n  <!--</div>-->\r\n\r\n  <!-- Header -->\r\n  <div style=\"text-align:center; border-bottom:4px solid #4a90e2; padding-bottom:10px; margin-bottom:20px;\">\r\n    <h1 style=\"margin:0; font-size:26px; color:#4a90e2;\">Bill Summary</h1>\r\n  </div>\r\n\r\n  <!-- Bill Details -->\r\n  <table style=\"width:100%; font-size:14px; border-collapse: collapse; margin-bottom:18px;\">\r\n    <tr>\r\n      <td style=\"padding:6px;\"><strong>Bill:</strong></td>\r\n      <td style=\"padding:6px;\">{{ doc.name }}</td>\r\n      <td style=\"padding:6px;\"><strong>Resident:</strong></td>\r\n      <td style=\"padding:6px;\">{{ doc.resident or '' }}</td>\r\n    </tr>\r\n    <tr>\r\n      <td style=\"padding:6px;\"><strong>Billing Month:</strong></td>\r\n      <td style=\"padding:6px;\">{{ doc.billing_month or '' }}</td>\r\n      <td style=\"padding:6px;\"><strong>Billing Year:</strong></td>\r\n      <td style=\"padding:6px;\">{{ doc.billing_year or '' }}</td>\r\n    </tr>\r\n    <tr>\r\n      <td style=\"padding:6px;\"><strong>Total (with Late Fee):</strong></td>\r\n      <td style=\"padding:6px;\">{{ \"{:,.2f}\".format(doc.total_with_late or 0) }}</td>\r\n      <td style=\"padding:6px;\"><strong>Status:</strong></td>\r\n      <td style=\"padding:6px;\">{{ doc.status or '' }}</td>\r\n    </tr>\r\n  </table>\r\n\r\n  <!-- Consumption Details -->\r\n  <h3 style=\"color:#4a90e2; margin:12px 0 8px;\">Consumption Details</h3>\r\n  <table style=\"width:100%; border-collapse:collapse; font-size:13px; border:1px solid #ccc;\" cellpadding=\"6\">\r\n    <thead style=\"background:#f0f6ff;\">\r\n      <tr>\r\n        <th style=\"border:1px solid #ccc; text-align:left;\">Consumption Log</th>\r\n        <th style=\"border:1px solid #ccc; text-align:left;\">Utility</th>\r\n        <th style=\"border:1px solid #ccc; text-align:center;\">Units</th>\r\n        <th style=\"border:1px solid #ccc; text-align:right;\">Rate</th>\r\n        <th style=\"border:1px solid #ccc; text-align:right;\">Amount</th>\r\n      </tr>\r\n    </thead>\r\n    <tbody>\r\n      {% for bill_row in doc.items %}\r\n        {% if bill_row.consumption_log %}\r\n          {% set log = frappe.get_doc(\"Consumption Log\", bill_row.consumption_log) %}\r\n          {% if log and log.consumption_items %}\r\n            {% for li in log.consumption_items %}\r\n              <tr>\r\n                <td style=\"border:1px solid #ccc;\">{{ log.name }}</td>\r\n                <td style=\"border:1px solid #ccc;\">{{ li.utility or '' }}</td>\r\n                <td style=\"text-align:center; border:1px solid #ccc;\">{{ li.units or 0 }}</td>\r\n                <td style=\"text-align:right; border:1px solid #ccc;\">{{ \"{:,.2f}\".format(li.rate or 0) }}</td>\r\n                <td style=\"text-align:right; border:1px solid #ccc;\">{{ \"{:,.2f}\".format(li.amount or 0) }}</td>\r\n              </tr>\r\n            {% endfor %}\r\n          {% endif %}\r\n        {% endif %}\r\n      {% endfor %}\r\n    </tbody>\r\n  </table>\r\n\r\n  <!-- Payment Details -->\r\n  <h3 style=\"color:#4a90e2; margin:20px 0 8px;\">Payment Details</h3>\r\n  <table style=\"width:100%; border-collapse:collapse; font-size:13px; border:1px solid #ccc;\" cellpadding=\"6\">\r\n    <thead style=\"background:#f9f9f9;\">\r\n      <tr>\r\n        <th style=\"border:1px solid #ccc; text-align:left;\">Payment Mode</th>\r\n        <th style=\"border:1px solid #ccc; text-align:left;\">Payment ID</th>\r\n        <th style=\"border:1px solid #ccc; text-align:left;\">Date</th>\r\n        <th style=\"border:1px solid #ccc; text-align:right;\">Amount</th>\r\n        <th style=\"border:1px solid #ccc; text-align:left;\">Status</th>\r\n      </tr>\r\n    </thead>\r\n    <tbody>\r\n      {% set payments = frappe.get_all(\"Payment\", filters={\"bill\": doc.name}, fields=[\"payment_mode\", \"payment_id\", \"date\", \"amount\", \"status\"]) %}\r\n      {% if payments %}\r\n        {% for p in payments %}\r\n          <tr>\r\n            <td style=\"border:1px solid #ccc;\">{{ p.payment_mode or '-' }}</td>\r\n            <td style=\"border:1px solid #ccc;\">{{ p.payment_id or '-' }}</td>\r\n            <td style=\"border:1px solid #ccc;\">{{ p.date or '-' }}</td>\r\n            <td style=\"text-align:right; border:1px solid #ccc;\">{{ \"{:,.2f}\".format(p.amount or 0) }}</td>\r\n            <td style=\"border:1px solid #ccc;\">{{ p.status or '-' }}</td>\r\n          </tr>\r\n        {% endfor %}\r\n      {% else %}\r\n        <tr>\r\n          <td colspan=\"5\" style=\"text-align:center; color:#888; border:1px solid #ccc;\">No payment records found</td>\r\n        </tr>\r\n      {% endif %}\r\n    </tbody>\r\n  </table>\r\n\r\n  <!-- Footer -->\r\n  <div style=\"margin-top:20px; text-align:center; font-size:13px; color:#666;\">\r\n    <p style=\"margin:6px 0;\"><em>Thank you for paying!</em></p>\r\n    <p style=\"margin:0;\">Smart Community · Automated Billing System</p>\r\n  </div>\r\n</div>\r\n",
